        {
          "name": "Delete Appointment",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/appointments/APT-001",
              "host": ["{{baseUrl}}"],
              "path": ["appointments","APT-001"]
            }
          }
        }
      ]
    },

    {
      "name": "Doctor Profile",
      "item": [
